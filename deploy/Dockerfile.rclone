FROM golang:1.26-bookworm AS build
ARG RCLONE_REV=dev
RUN echo "rclone fork rev: $RCLONE_REV" \
    && git clone --depth 1 https://github.com/torrin-app/rclone /rclone \
    && cd /rclone && CGO_ENABLED=0 go build -o /rclone-bin .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /rclone-bin /usr/local/bin/rclone
EXPOSE 5572
ENTRYPOINT ["rclone", "rcd", "--rc-addr", "0.0.0.0:5572", "--rc-no-auth", "--rc-serve", \
            "--config", "/data/rclone.conf", "--log-level", "INFO"]
